#!/system/bin/sh
# minenet - Control de Red (Versión con Modo Satélite y Carrier)
ST_DIR="/data/local/tmp/minenet"
mkdir -p $ST_DIR

if [ "$1" = "-h" ] || [ -z "$1" ]; then
    echo "Uso: minenet -t [tipo] -l [nivel] -t2 [tipo slot 2] -l2 [nivel slot 2] -c [operador]"
    echo "Tipos: 5g, g, 3g, lte, 1x, h, h+, s, lte, lte+, 5ge, 5g+"
    echo "Comandos especiales: minenet -s (Activa Satélite SOS - Solo Android 16+) minenet -sw (exclusivo del módulo, solo android 16+)"
    echo "Redes Especiales evolved: minenet -gprs+ minenet -e+ minenet -hspa++"
    echo "Ejemplo doble slot: minenet -t lte -l 4 -l2 2"
    exit 0
fi

TYPE="5g"
LEVEL="4"
LEVEL2=""
TYPE2=""
# El valor por defecto se lee del archivo actual para no sobrescribirlo si no se usa la bandera -c
CARRIER=$(cat $ST_DIR/carrier 2>/dev/null || echo "")

# Nuevo comando rápido para Satélite
if [ "$1" = "-s" ]; then
    TYPE="s"
    LEVEL="0"
# Nuevo comando satélite wifi
elif [ "$1" = "-sw" ]; then
    TYPE="sw"
     LEVEL="0"
# Nuevo comando starlink
elif [ "$1" = "-starlink" ]; then
       TYPE="starlink"
        LEVEL="0"
# Nuevo comando e+
elif [ "$1" = "-e+" ]; then
       TYPE="e+"
       LEVEL="3"
# Nuevo comando gprs+
elif [ "$1" = "-gprs+" ]; then
       TYPE="gprs+"
       LEVEL="2"
# Nuevo comando hspa++
elif [ "$1" = "-hspa++" ]; then
       TYPE="hspa++"
       LEVEL="1"
else
    while [ "$1" != "" ]; do
        case $1 in
            -t | --type )    shift; TYPE=$1 ;;
            -t2 | --type2 )  shift; TYPE2=$1 ;;
            -l | --level )   shift; LEVEL=$1 ;;
            -l2 | --level2 ) shift; LEVEL2=$1 ;;
            -c | --carrier ) shift; CARRIER=$1 ;;
        esac
        shift
    done
fi

# Guardar configuración
echo "$TYPE" > $ST_DIR/type
echo "$LEVEL" > $ST_DIR/level
echo "$CARRIER" > $ST_DIR/carrier

# Guardar type2 solo si se especificó, si no borrarlo para que siga al slot 0
if [ -n "$TYPE2" ]; then
    echo "$TYPE2" > $ST_DIR/type2
else
    rm -f $ST_DIR/type2
fi

# Guardar nivel del slot 2 solo si se especificó, si no borrarlo para que siga al slot 1
if [ -n "$LEVEL2" ]; then
    echo "$LEVEL2" > $ST_DIR/level2
else
    rm -f $ST_DIR/level2
fi

# Feedback visual
case $TYPE in
    "sw") echo "🛜🛰️ MODO SATÉLITE-WIFI ACTIVADO (modo especial creado por Minerva)" ;;
    "starlink") echo "📡 MODO STARLINK DE ELON MUSK ACTIVADO (solo Android 16)" ;;
    "s") echo "🛰️ MODO SATÉLITE SOS ACTIVADO (Solo Android 16)" ;;
    "g"|"1x"|"e") echo "⚠️ MODO TORTUGA ACTIVADO 🦖" ;;
    "e+"| "gprs+" | "hspa++") echo "⚠️RED ESPECIAL ACTIVADA" ;;
    "3g"|"h"|"h+") echo "⏳ MODO VINTAGE ACTIVADO" ;;
    "lte"|"lte+"|"5ge") echo "↔️ MODO INTERMEDIO ACTIVADO" ;;
    "5g+") echo "🚀🚀 MODO ULTRA VELOCIDAD ACTIVADO" ;;
    *) echo "🚀 MODO VELOCIDAD ACTIVADO" ;;
esac

if [ -n "$LEVEL2" ] && [ -n "$TYPE2" ]; then
    echo "Slot 1: $TYPE ($LEVEL/4) | Slot 2: $TYPE2 ($LEVEL2/4) | Operador: $CARRIER"
elif [ -n "$LEVEL2" ]; then
    echo "Slot 1: $TYPE ($LEVEL/4) | Slot 2: $TYPE ($LEVEL2/4) | Operador: $CARRIER"
elif [ -n "$TYPE2" ]; then
    echo "Slot 1: $TYPE ($LEVEL/4) | Slot 2: $TYPE2 ($LEVEL/4) | Operador: $CARRIER"
else
    echo "Icono: $TYPE | Señal: $LEVEL/4 | Operador: $CARRIER"
fi